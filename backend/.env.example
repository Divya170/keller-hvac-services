# Port the NestJS API listens on
PORT=4200

# SQLite3 database file (relative to the backend folder)
DATABASE_PATH=../database/app.sqlite

# Folder for uploaded files: request photos (private) and site images
UPLOADS_PATH=../database/uploads

# Keep the schema in sync with the entities (fine for SQLite; set false once you add migrations)
DB_SYNCHRONIZE=true

# Origin of the Next.js frontend (only needed if the browser calls the API directly)
FRONTEND_ORIGIN=http://localhost:3200

# First admin account, created on first start if no admin exists. CHANGE THE PASSWORD.
ADMIN_EMAIL=bryce.keller@kellerhvac.com
ADMIN_PASSWORD=keller-admin

# Secret used to sign admin sessions and request-form tokens. Use a long random string in production.
APP_SECRET=change-me-to-a-long-random-string

# Admin session length in hours
ADMIN_SESSION_HOURS=8
